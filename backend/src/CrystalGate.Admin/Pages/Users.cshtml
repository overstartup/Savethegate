@page
@model CrystalGate.Admin.Pages.UsersModel
@{
    ViewData["Title"] = "Players";
}

<h2>Players <small class="text-muted">(@Model.Players.Count)</small></h2>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success py-2">@Model.StatusMessage</div>
}

<table class="table table-striped table-sm align-middle">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
            <th>Recovery code</th>
            <th>Device Id</th>
            <th>Coins</th>
            <th>Power</th>
            <th>Speed</th>
            <th>Haste</th>
            <th>Stage</th>
            <th>Best score</th>
            <th>Last seen (UTC)</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Players)
    {
        <tr>
            <td>@p.Id</td>
            <td>
                <form method="post" asp-page-handler="Rename" class="d-flex gap-1">
                    <input type="hidden" name="id" value="@p.Id" />
                    <input class="form-control form-control-sm" name="newName" value="@p.Name" style="width:120px" />
                    <button class="btn btn-sm btn-outline-primary" type="submit">Save</button>
                </form>
            </td>
            <td class="small">@(p.Email ?? "—")</td>
            <td><code class="small">@p.RecoveryCode</code></td>
            <td><code class="small">@p.DeviceId</code></td>
            <td>@p.Coins</td>
            <td>@p.PowerLevel</td>
            <td>@p.SpeedLevel</td>
            <td>@p.FireRateLevel</td>
            <td>@p.CurrentStage</td>
            <td>@(Model.BestScores.TryGetValue(p.Id, out var best) ? best : 0)</td>
            <td class="small">@p.LastSeenAt.ToString("u")</td>
            <td>
                @if (p.IsBanned)
                {
                    <span class="badge bg-danger">Banned</span>
                }
                else
                {
                    <span class="badge bg-success">Active</span>
                }
            </td>
            <td class="d-flex gap-1">
                <form method="post" asp-page-handler="ToggleBan">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button class="btn btn-sm @(p.IsBanned ? "btn-outline-success" : "btn-outline-warning")" type="submit">
                        @(p.IsBanned ? "Unban" : "Ban")
                    </button>
                </form>
                <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this player and all their scores?');">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
