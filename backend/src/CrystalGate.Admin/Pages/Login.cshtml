@page
@model CrystalGate.Admin.Pages.LoginModel
@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Landgate Admin — Login</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body style="background:#1c1238;">
    <div class="d-flex align-items-center justify-content-center" style="min-height:100vh;">
        <div class="card shadow" style="width: 340px;">
            <div class="card-body">
                <h4 class="card-title mb-3">Landgate Admin</h4>
                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger py-2">@Model.Error</div>
                }
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input class="form-control" name="Username" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input class="form-control" type="password" name="Password" required />
                    </div>
                    <button class="btn btn-primary w-100" type="submit">Sign in</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
