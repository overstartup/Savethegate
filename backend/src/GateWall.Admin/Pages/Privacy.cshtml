@page
@model PrivacyModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Save the gate — Privacy Policy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --sky:#8ed6fe; --grass:#8fcE8f; --grass2:#7bc47f;
    --ink:#2b2b2b; --muted:#6b6f66; --card:#ffffff;
    --accent:#3aa06a; --accent-dark:#237a4d;
    --font-display:'Baloo 2', -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  }
  *{box-sizing:border-box;}
  body{
    font-family:-apple-system, Segoe UI, Roboto, Arial, sans-serif;
    margin:0; padding:0; color:var(--ink); line-height:1.65;
    background:linear-gradient(180deg,#eaf7ff 0%, #f4faf1 340px, #fbfbf8 100%);
  }
  .hero{
    background:linear-gradient(180deg, var(--sky) 0%, var(--grass) 100%);
    padding:38px 20px 54px; text-align:center; position:relative; overflow:hidden;
  }
  .hero::before, .hero::after{
    content:''; position:absolute; border-radius:50%; background:rgba(255,255,255,.35);
  }
  .hero::before{ width:90px; height:90px; top:-20px; left:-20px; }
  .hero::after{ width:140px; height:140px; bottom:-60px; right:-30px; }
  .badge{
    width:84px; height:84px; margin:0 auto 14px; border-radius:50%;
    background:#fff; box-shadow:0 6px 18px rgba(0,0,0,.12);
    display:flex; align-items:center; justify-content:center; position:relative; z-index:1;
  }
  .badge svg{ width:64px; height:64px; }
  .hero h1{
    font-family:var(--font-display); font-weight:800; font-size:28px; margin:0 0 6px;
    color:#1f3d2a; position:relative; z-index:1;
  }
  .hero .tag{
    font-size:14px; color:#2f4f3a; opacity:.85; margin:0; position:relative; z-index:1;
  }
  .updated{
    display:inline-block; margin-top:14px; background:rgba(255,255,255,.75);
    border-radius:999px; padding:5px 14px; font-size:12.5px; color:#2f4f3a;
    position:relative; z-index:1; font-weight:600;
  }
  .wrap{ max-width:720px; margin:-28px auto 60px; padding:0 18px; position:relative; z-index:2; }
  .card{
    background:var(--card); border-radius:16px; padding:22px 22px 6px;
    box-shadow:0 10px 30px rgba(20,50,30,.08); margin-bottom:18px;
  }
  .intro-card p{ margin:0 0 16px; color:#3a3a3a; }
  .company-box{
    background:#f4f8ee; border-radius:12px; padding:16px 18px; font-size:14px; margin:16px 0;
  }
  .company-box p{ margin:4px 0; }
  h2{
    font-family:var(--font-display); font-weight:700; font-size:18px; margin:0 0 10px;
    color:var(--accent-dark); display:flex; align-items:center; gap:8px;
  }
  h2 .num{
    display:inline-flex; align-items:center; justify-content:center;
    width:24px; height:24px; border-radius:50%; background:var(--accent);
    color:#fff; font-size:12px; font-family:-apple-system, Segoe UI, Roboto, Arial, sans-serif;
    font-weight:700; flex:none;
  }
  section p, section ul{ font-size:14.5px; color:#3d3d3d; margin:0 0 16px; }
  ul{ padding-left:20px; }
  li{ margin-bottom:4px; }
  a{ color:var(--accent-dark); text-decoration:none; border-bottom:1px solid rgba(35,122,77,.3); }
  a:hover{ border-bottom-color:var(--accent-dark); }
  .toc{
    display:flex; flex-wrap:wrap; gap:8px; margin-bottom:0;
  }
  .toc a{
    border:none; background:#f0f6ea; color:var(--accent-dark); font-weight:600;
    font-size:12.5px; padding:6px 12px; border-radius:999px;
  }
  .toc a:hover{ background:#e2edd7; }
  table{ width:100%; border-collapse:collapse; font-size:13.5px; margin:0 0 16px; }
  th, td{ text-align:left; padding:8px 10px; border-bottom:1px solid #eee; vertical-align:top; }
  th{ color:#5c5c5c; font-weight:700; font-size:12px; text-transform:uppercase; letter-spacing:.02em; }
  .pill{
    display:inline-block; padding:2px 9px; border-radius:999px; font-size:11.5px; font-weight:700;
  }
  .pill.no{ background:#e9f6ec; color:var(--accent-dark); }
  .pill.yes{ background:#fdeee0; color:#a15a12; }
  .platform-note{
    background:#fbf6e6; border-left:3px solid #e0b23a; border-radius:8px;
    padding:10px 14px; font-size:13px; color:#5c4a13; margin:0 0 16px;
  }
  footer{ text-align:center; font-size:12px; color:#8a8a8a; padding:0 18px 30px; }
  footer a{ color:#8a8a8a; }
</style>
</head>
<body>

