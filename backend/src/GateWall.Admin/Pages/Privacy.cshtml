          <radialGradient id="cheekGrad" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#ffc9d6" stop-opacity=".85"/><stop offset="100%" stop-color="#ffc9d6" stop-opacity="0"/></radialGradient>
        </defs>
        <circle cx="100" cy="100" r="96" fill="url(#skyGrad)"/>
        <g transform="rotate(-15 85 96)"><ellipse cx="78" cy="57" rx="13.5" ry="34" fill="url(#earOuter)" stroke="#e3d2b2" stroke-width="1.6"/><ellipse cx="78" cy="60" rx="6.6" ry="23" fill="url(#earInner)"/></g>
        <g transform="rotate(15 115 96)"><ellipse cx="122" cy="57" rx="13.5" ry="34" fill="url(#earOuter)" stroke="#e3d2b2" stroke-width="1.6"/><ellipse cx="122" cy="60" rx="6.6" ry="23" fill="url(#earInner)"/></g>
        <circle cx="100" cy="120" r="40" fill="url(#bodyGrad)" stroke="#e3d2b2" stroke-width="1.6"/>
        <ellipse cx="78" cy="130" rx="9" ry="6.5" fill="url(#cheekGrad)"/><ellipse cx="122" cy="130" rx="9" ry="6.5" fill="url(#cheekGrad)"/>
        <circle cx="85" cy="114" r="4.6" fill="#3a2b22"/><circle cx="115" cy="114" r="4.6" fill="#3a2b22"/>
        <circle cx="83.2" cy="111.8" r="1.5" fill="#ffffff"/><circle cx="113.2" cy="111.8" r="1.5" fill="#ffffff"/>
        <ellipse cx="100" cy="126" rx="3.6" ry="2.6" fill="#d98a86"/>
        <path d="M92,132.5 Q100,140 108,132.5" stroke="#b06b53" stroke-width="1.8" stroke-linecap="round" fill="none"/>
      </svg>
    </div>
    <h1>Privacy Policy</h1>
    <p class="tag">Save the gate, published under the Turtoo brand</p>
    <span class="updated">Last updated: July 29, 2026</span>
  </div>

  <div class="wrap">

    <div class="card intro-card">
      <p>Save the gate ("the app") is a mobile game published under the Turtoo brand. This page explains what information the app collects, why, and how it's used — in plain language, not legalese. The app does not require account sign-up and does not collect your real name, email address, or any other directly identifying information. Save the gate is a general-audience, family-friendly game; it is not primarily directed at or exclusively marketed to children under 13.</p>
